     /**
+     * CatTunnel: on Android 13+ the included routes go in as they are and the
+     * excluded ones through [Builder.excludeRoute], instead of "included minus
+     * excluded" computed here. The complement of N scattered networks is
+     * ~10 routes per network (31 Russian blocks -> ~360 routes, the full
+     * lists -> thousands), all handed to the OS in one Binder call; natively
+     * it's just the N networks. Everything is parsed before the builder is
+     * touched, so on a bad entry the caller falls back to the complement
+     * with a clean builder. Returns false when not used.
+     */
+    private fun addRoutesNatively(builder: Builder, included: List<String>, excluded: List<String>): Boolean {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return false
+        fun parse(cidrs: List<String>) = cidrs.map {
+            NetworkUtils.convertCidrToIpPrefix(it) ?: throw IllegalArgumentException("Wrong route: $it")
+        }
+        val (include, exclude) = try {
+            parse(included) to parse(excluded)
+        } catch (e: Exception) {
+            LOG.warn("Routes: can't parse for excludeRoute, computing the complement", e)
+            return false
+        }
+        include.forEach { builder.addRoute(it) }
+        exclude.forEach { builder.excludeRoute(it) }
+        LOG.info("Routes: ${include.size} included, ${exclude.size} excluded natively (Android 13+)")
+        return true
+    }
+
