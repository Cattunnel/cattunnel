     /**
+     * CatTunnel: which apps the tunnel captures. Android allows either an
+     * allow-list or a deny-list per Builder, not both:
+     * - included_apps set: only those apps use the VPN (our own app can't be
+     *   among them - it would loop through its own tunnel);
+     * - otherwise everything except excluded_apps and our own app.
+     * Packages that aren't installed are skipped.
+     */
+    private fun applyAppSplit(builder: Builder, tunConfig: Tun) {
+        val self = applicationContext.packageName
+        val included = tunConfig.includedApps.filter { it != self }
+        if (included.isNotEmpty()) {
+            var added = 0
+            included.forEach { app ->
+                try {
+                    builder.addAllowedApplication(app)
+                    added++
+                } catch (e: PackageManager.NameNotFoundException) {
+                    LOG.info("Split tunneling: $app is not installed, skipped")
+                }
+            }
+            if (added > 0) {
+                LOG.info("Split tunneling: only $added app(s) use the VPN")
+                return
+            }
+            LOG.info("Split tunneling: none of the included apps is installed, the VPN covers everything")
+        }
+
+        builder.addDisallowedApplication(self)
+        var excluded = 0
+        tunConfig.excludedApps.filter { it != self }.forEach { app ->
+            try {
+                builder.addDisallowedApplication(app)
+                excluded++
+            } catch (e: PackageManager.NameNotFoundException) {
+                LOG.info("Split tunneling: $app is not installed, skipped")
+            }
+        }
+        if (excluded > 0) LOG.info("Split tunneling: $excluded app(s) bypass the VPN")
+    }
+
