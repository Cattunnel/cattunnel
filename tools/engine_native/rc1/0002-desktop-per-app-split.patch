+++ b/trusttunnel/include/vpn/trusttunnel/process_owner.h
@@ -0,0 +1,65 @@
+#pragma once
+
+// CatTunnel: per-app split on the desktop (Windows, Linux) without a driver.
+//
+// Every connection still enters the TUN device. When the core asks what to do
+// with a new connection (VPN_EVENT_CONNECT_REQUEST), the client finds the
+// process that owns the socket by its addresses and answers "bypass" for the
+// apps the user excluded (or for every app outside the list in the
+// "only these apps" mode). The lookup uses the system's own connection tables:
+// GetExtendedTcpTable/GetExtendedUdpTable on Windows, NETLINK_SOCK_DIAG plus
+// /proc/<pid>/fd on Linux.
+
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+struct sockaddr;
+
+namespace ag {
+
+/** Full path of the executable that owns the socket `src` -> `dst` (`proto` is IPPROTO_TCP or
+ * IPPROTO_UDP), or nullopt when it can't be told (not found, no access, unsupported platform).
+ * `dst` may be null. Blocking: call it off the VPN's event loop. */
+std::optional<std::string> find_socket_owner_path(int proto, const sockaddr *src, const sockaddr *dst);
+
+/** The app lists from `[listener.tun]` and the decision built on them. */
+class AppSplit {
+public:
+    AppSplit() = default;
+    AppSplit(std::vector<std::string> excluded, std::vector<std::string> included);
+
+    /** Whether there is anything to decide (both lists empty = everything as before). */
+    [[nodiscard]] bool enabled() const {
+        return !m_excluded.empty() || !m_included.empty();
+    }
+
+    /** True if the connection of the program at `path` goes directly, outside the tunnel.
+     * An unknown program (`path` empty) always stays in the tunnel. */
+    [[nodiscard]] bool bypass(std::string_view path) const;
+
+    /** `bypass` for a connection, with a short cache by local port so that a burst of
+     * connections from one socket doesn't repeat the lookup. Thread-safe. */
+    bool bypass_connection(int proto, const sockaddr *src, const sockaddr *dst, std::string *owner_out);
+
+    /** Whether `path` matches an entry: the full path, or just the file name
+     * ("chrome.exe", "firefox"). Case-insensitive on Windows. */
+    static bool matches(std::string_view entry, std::string_view path);
+
+private:
+    std::vector<std::string> m_excluded;
+    std::vector<std::string> m_included;
+
+    struct CacheEntry {
+        std::string owner;
+        int64_t expires_ms;
+    };
+    std::mutex m_mutex;
+    std::unordered_map<uint64_t, CacheEntry> m_cache;
+};
+
+} // namespace ag
