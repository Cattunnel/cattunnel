diff --git a/trusttunnel/src/process_owner.cpp b/trusttunnel/src/process_owner.cpp
new file mode 100644
index 00000000..69fbb863
--- /dev/null
+++ b/trusttunnel/src/process_owner.cpp
@@ -0,0 +1,426 @@
+#include "vpn/trusttunnel/process_owner.h"
+
+#include <algorithm>
+#include <cctype>
+#include <iterator>
+#include <chrono>
+#include <utility>
+#include <cstring>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <iphlpapi.h>
+#include <windows.h>
+#pragma comment(lib, "iphlpapi.lib")
+#else
+#include <netinet/in.h>
+#include <sys/socket.h>
+#endif
+
+#if defined(__linux__) && !defined(__ANDROID__)
+#include <dirent.h>
+#include <cstdlib>
+#include <linux/inet_diag.h>
+#include <linux/netlink.h>
+#include <linux/sock_diag.h>
+#include <sys/time.h>
+#include <unistd.h>
+#endif
+
+namespace ag {
+
+namespace {
+
+uint16_t port_of(const sockaddr *sa) {
+    if (sa == nullptr) {
+        return 0;
+    }
+    if (sa->sa_family == AF_INET) {
+        return ((const sockaddr_in *) sa)->sin_port; // network order
+    }
+    if (sa->sa_family == AF_INET6) {
+        return ((const sockaddr_in6 *) sa)->sin6_port;
+    }
+    return 0;
+}
+
+int64_t now_ms() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+}
+
+std::string_view file_name(std::string_view path) {
+    size_t pos = path.find_last_of("/\\");
+    return pos == std::string_view::npos ? path : path.substr(pos + 1);
+}
+
+bool equal_names(std::string_view a, std::string_view b) {
+#ifdef _WIN32
+    return a.size() == b.size()
+            && std::equal(a.begin(), a.end(), b.begin(), [](char x, char y) {
+                   return std::tolower((unsigned char) x) == std::tolower((unsigned char) y);
+               });
+#else
+    return a == b;
+#endif
+}
+
+#ifdef _WIN32
+
+std::optional<std::string> pid_path(DWORD pid) {
+    if (pid == 0 || pid == 4) {
+        return std::nullopt; // Idle / System
+    }
+    HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+    if (h == nullptr) {
+        return std::nullopt;
+    }
+    wchar_t buf[MAX_PATH * 2];
+    DWORD len = std::size(buf);
+    BOOL ok = QueryFullProcessImageNameW(h, 0, buf, &len);
+    CloseHandle(h);
+    if (!ok || len == 0) {
+        return std::nullopt;
+    }
+    int n = WideCharToMultiByte(CP_UTF8, 0, buf, (int) len, nullptr, 0, nullptr, nullptr);
+    std::string out(n, '\0');
+    WideCharToMultiByte(CP_UTF8, 0, buf, (int) len, out.data(), n, nullptr, nullptr);
+    return out;
+}
+
+template <typename Fn>
+bool with_table(bool tcp, ULONG family, Fn &&fn) {
+    DWORD size = 0;
+    std::vector<uint8_t> buf;
+    for (int attempt = 0; attempt < 3; ++attempt) {
+        DWORD rc = tcp ? GetExtendedTcpTable(buf.empty() ? nullptr : buf.data(), &size, FALSE, family,
+                                 TCP_TABLE_OWNER_PID_ALL, 0)
+                       : GetExtendedUdpTable(buf.empty() ? nullptr : buf.data(), &size, FALSE, family,
+                                 UDP_TABLE_OWNER_PID, 0);
+        if (rc == NO_ERROR && !buf.empty()) {
+            fn(buf.data());
+            return true;
+        }
+        if (rc != ERROR_INSUFFICIENT_BUFFER && !(rc == NO_ERROR && buf.empty())) {
+            return false;
+        }
+        buf.resize(size + 4096); // the table can grow between the two calls
+        size = (DWORD) buf.size();
+    }
+    return false;
+}
+
+std::optional<DWORD> owner_pid(int proto, const sockaddr *src, const sockaddr *dst) {
+    bool tcp = proto == IPPROTO_TCP;
+    std::optional<DWORD> pid;
+    if (src->sa_family == AF_INET) {
+        auto *s = (const sockaddr_in *) src;
+        auto *d = (dst != nullptr && dst->sa_family == AF_INET) ? (const sockaddr_in *) dst : nullptr;
+        with_table(tcp, AF_INET, [&](uint8_t *p) {
+            if (tcp) {
+                auto *t = (MIB_TCPTABLE_OWNER_PID *) p;
+                for (DWORD i = 0; i < t->dwNumEntries && !pid; ++i) {
+                    const auto &r = t->table[i];
+                    if ((uint16_t) r.dwLocalPort == s->sin_port && r.dwLocalAddr == s->sin_addr.s_addr
+                            && (d == nullptr
+                                    || ((uint16_t) r.dwRemotePort == d->sin_port
+                                            && r.dwRemoteAddr == d->sin_addr.s_addr))) {
+                        pid = r.dwOwningPid;
+                    }
+                }
+            } else {
+                auto *t = (MIB_UDPTABLE_OWNER_PID *) p;
+                std::optional<DWORD> wildcard;
+                for (DWORD i = 0; i < t->dwNumEntries && !pid; ++i) {
+                    const auto &r = t->table[i];
+                    if ((uint16_t) r.dwLocalPort != s->sin_port) {
+                        continue;
+                    }
+                    if (r.dwLocalAddr == s->sin_addr.s_addr) {
+                        pid = r.dwOwningPid;
+                    } else if (r.dwLocalAddr == INADDR_ANY && !wildcard) {
+                        wildcard = r.dwOwningPid;
+                    }
+                }
+                if (!pid) {
+                    pid = wildcard;
+                }
+            }
+        });
+    } else if (src->sa_family == AF_INET6) {
+        auto *s = (const sockaddr_in6 *) src;
+        auto *d = (dst != nullptr && dst->sa_family == AF_INET6) ? (const sockaddr_in6 *) dst : nullptr;
+        static const uint8_t any6[16] = {};
+        with_table(tcp, AF_INET6, [&](uint8_t *p) {
+            if (tcp) {
+                auto *t = (MIB_TCP6TABLE_OWNER_PID *) p;
+                for (DWORD i = 0; i < t->dwNumEntries && !pid; ++i) {
+                    const auto &r = t->table[i];
+                    if ((uint16_t) r.dwLocalPort == s->sin6_port
+                            && memcmp(r.ucLocalAddr, &s->sin6_addr, 16) == 0
+                            && (d == nullptr
+                                    || ((uint16_t) r.dwRemotePort == d->sin6_port
+                                            && memcmp(r.ucRemoteAddr, &d->sin6_addr, 16) == 0))) {
+                        pid = r.dwOwningPid;
+                    }
+                }
+            } else {
+                auto *t = (MIB_UDP6TABLE_OWNER_PID *) p;
+                std::optional<DWORD> wildcard;
+                for (DWORD i = 0; i < t->dwNumEntries && !pid; ++i) {
+                    const auto &r = t->table[i];
+                    if ((uint16_t) r.dwLocalPort != s->sin6_port) {
+                        continue;
+                    }
+                    if (memcmp(r.ucLocalAddr, &s->sin6_addr, 16) == 0) {
+                        pid = r.dwOwningPid;
+                    } else if (memcmp(r.ucLocalAddr, any6, 16) == 0 && !wildcard) {
+                        wildcard = r.dwOwningPid;
+                    }
+                }
+                if (!pid) {
+                    pid = wildcard;
+                }
+            }
+        });
+    }
+    return pid;
+}
+
+#elif defined(__linux__) && !defined(__ANDROID__)
+
+// One exact lookup through NETLINK_SOCK_DIAG: the kernel finds the socket by its
+// addresses (an unconnected UDP socket matches too) and returns its inode.
+std::optional<uint32_t> diag_inode(int proto, const sockaddr *src, const sockaddr *dst) {
+    int fd = socket(AF_NETLINK, SOCK_DGRAM | SOCK_CLOEXEC, NETLINK_SOCK_DIAG);
+    if (fd < 0) {
+        return std::nullopt;
+    }
+    struct {
+        nlmsghdr nlh;
+        inet_diag_req_v2 req;
+    } msg{};
+    msg.nlh.nlmsg_len = sizeof(msg);
+    msg.nlh.nlmsg_type = SOCK_DIAG_BY_FAMILY;
+    msg.nlh.nlmsg_flags = NLM_F_REQUEST;
+    msg.req.sdiag_family = src->sa_family;
+    msg.req.sdiag_protocol = proto;
+    msg.req.idiag_states = ~0U;
+    msg.req.id.idiag_cookie[0] = INET_DIAG_NOCOOKIE;
+    msg.req.id.idiag_cookie[1] = INET_DIAG_NOCOOKIE;
+    if (src->sa_family == AF_INET) {
+        auto *s = (const sockaddr_in *) src;
+        msg.req.id.idiag_sport = s->sin_port;
+        memcpy(msg.req.id.idiag_src, &s->sin_addr, 4);
+        if (dst != nullptr && dst->sa_family == AF_INET) {
+            auto *d = (const sockaddr_in *) dst;
+            msg.req.id.idiag_dport = d->sin_port;
+            memcpy(msg.req.id.idiag_dst, &d->sin_addr, 4);
+        }
+    } else {
+        auto *s = (const sockaddr_in6 *) src;
+        msg.req.id.idiag_sport = s->sin6_port;
+        memcpy(msg.req.id.idiag_src, &s->sin6_addr, 16);
+        if (dst != nullptr && dst->sa_family == AF_INET6) {
+            auto *d = (const sockaddr_in6 *) dst;
+            msg.req.id.idiag_dport = d->sin6_port;
+            memcpy(msg.req.id.idiag_dst, &d->sin6_addr, 16);
+        }
+    }
+    if (proto == IPPROTO_UDP) {
+        // The kernel looks a UDP socket up as for an incoming packet (udp_dump_one ->
+        // __udp4_lib_lookup(saddr = idiag_src, ..., daddr = idiag_dst)): "src" is the
+        // remote side there, the local socket is "dst". TCP takes them the other way round.
+        std::swap(msg.req.id.idiag_sport, msg.req.id.idiag_dport);
+        std::swap(msg.req.id.idiag_src, msg.req.id.idiag_dst);
+    }
+    sockaddr_nl kernel{};
+    kernel.nl_family = AF_NETLINK;
+    std::optional<uint32_t> inode;
+    if (sendto(fd, &msg, sizeof(msg), 0, (sockaddr *) &kernel, sizeof(kernel)) == (ssize_t) sizeof(msg)) {
+        timeval tv{.tv_sec = 0, .tv_usec = 300000};
+        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+        alignas(nlmsghdr) char buf[8192];
+        ssize_t n = recv(fd, buf, sizeof(buf), 0);
+        for (auto *h = (nlmsghdr *) buf; n > 0 && NLMSG_OK(h, (size_t) n); h = NLMSG_NEXT(h, n)) {
+            if (h->nlmsg_type == NLMSG_DONE || h->nlmsg_type == NLMSG_ERROR) {
+                break;
+            }
+            if (h->nlmsg_type == SOCK_DIAG_BY_FAMILY) {
+                auto *m = (inet_diag_msg *) NLMSG_DATA(h);
+                if (m->idiag_inode != 0) {
+                    inode = m->idiag_inode;
+                }
+                break;
+            }
+        }
+    }
+    close(fd);
+    return inode;
+}
+
+// The process holding the socket: /proc/<pid>/fd/* -> "socket:[<inode>]". One scan maps
+// every socket inode to its program, so a burst of new connections costs one pass.
+std::string exe_of(const char *pid) {
+    char exe[4096];
+    std::string link = std::string("/proc/") + pid + "/exe";
+    ssize_t len = readlink(link.c_str(), exe, sizeof(exe) - 1);
+    if (len <= 0) {
+        return {};
+    }
+    std::string path(exe, len);
+    constexpr std::string_view DELETED = " (deleted)"; // a replaced binary
+    if (path.size() > DELETED.size() && path.ends_with(DELETED)) {
+        path.resize(path.size() - DELETED.size());
+    }
+    return path;
+}
+
+std::mutex g_inode_mutex;
+std::unordered_map<uint32_t, std::string> g_inode_owner;
+int64_t g_inode_scanned_ms = 0;
+
+void scan_inodes() {
+    std::unordered_map<uint32_t, std::string> map;
+    DIR *proc = opendir("/proc");
+    if (proc == nullptr) {
+        return;
+    }
+    while (dirent *p = readdir(proc)) {
+        if (p->d_name[0] < '1' || p->d_name[0] > '9') {
+            continue;
+        }
+        std::string fd_dir = std::string("/proc/") + p->d_name + "/fd";
+        DIR *fds = opendir(fd_dir.c_str());
+        if (fds == nullptr) {
+            continue;
+        }
+        std::string exe;
+        while (dirent *f = readdir(fds)) {
+            if (f->d_name[0] == '.') {
+                continue;
+            }
+            char link[64];
+            std::string fd_path = fd_dir + "/" + f->d_name;
+            ssize_t len = readlink(fd_path.c_str(), link, sizeof(link) - 1);
+            unsigned inode = 0;
+            if (len > 9 && memcmp(link, "socket:[", 8) == 0) {
+                link[len] = '\0';
+                inode = (unsigned) strtoul(link + 8, nullptr, 10);
+            }
+            if (inode == 0) {
+                continue;
+            }
+            if (exe.empty()) {
+                exe = exe_of(p->d_name);
+            }
+            map.emplace(inode, exe);
+        }
+        closedir(fds);
+    }
+    closedir(proc);
+    g_inode_owner = std::move(map);
+    g_inode_scanned_ms = now_ms();
+}
+
+std::optional<std::string> inode_owner_path(uint32_t inode) {
+    std::scoped_lock l(g_inode_mutex);
+    auto it = g_inode_owner.find(inode);
+    if (it == g_inode_owner.end() && now_ms() - g_inode_scanned_ms > 200) {
+        scan_inodes();
+        it = g_inode_owner.find(inode);
+    }
+    if (it == g_inode_owner.end() || it->second.empty()) {
+        return std::nullopt;
+    }
+    return it->second;
+}
+
+#endif
+
+} // namespace
+
+std::optional<std::string> find_socket_owner_path(int proto, const sockaddr *src, const sockaddr *dst) {
+    if (src == nullptr || (src->sa_family != AF_INET && src->sa_family != AF_INET6)
+            || (proto != IPPROTO_TCP && proto != IPPROTO_UDP)) {
+        return std::nullopt;
+    }
+#ifdef _WIN32
+    if (std::optional pid = owner_pid(proto, src, dst)) {
+        return pid_path(*pid);
+    }
+    return std::nullopt;
+#elif defined(__linux__) && !defined(__ANDROID__)
+    std::optional inode = diag_inode(proto, src, dst);
+    if (!inode && dst != nullptr) {
+        inode = diag_inode(proto, src, nullptr); // e.g. a UDP socket bound to a wildcard address
+    }
+    if (inode) {
+        return inode_owner_path(*inode);
+    }
+    return std::nullopt;
+#else
+    return std::nullopt;
+#endif
+}
+
+AppSplit::AppSplit(std::vector<std::string> excluded, std::vector<std::string> included)
+        : m_excluded(std::move(excluded))
+        , m_included(std::move(included)) {
+}
+
+bool AppSplit::matches(std::string_view entry, std::string_view path) {
+    if (entry.empty() || path.empty()) {
+        return false;
+    }
+    bool entry_is_path = entry.find_first_of("/\\") != std::string_view::npos;
+    return entry_is_path ? equal_names(entry, path) : equal_names(entry, file_name(path));
+}
+
+bool AppSplit::bypass(std::string_view path) const {
+    if (path.empty()) {
+        return false;
+    }
+    auto in = [path](const std::vector<std::string> &list) {
+        return std::any_of(list.begin(), list.end(), [path](const std::string &e) {
+            return matches(e, path);
+        });
+    };
+    if (!m_included.empty()) {
+        return !in(m_included);
+    }
+    return in(m_excluded);
+}
+
+bool AppSplit::bypass_connection(int proto, const sockaddr *src, const sockaddr *dst, std::string *owner_out) {
+    uint64_t key = ((uint64_t) proto << 32) | ((uint64_t) (src ? src->sa_family : 0) << 16) | port_of(src);
+    int64_t now = now_ms();
+    std::string owner;
+    bool cached = false;
+    {
+        std::scoped_lock l(m_mutex);
+        if (auto it = m_cache.find(key); it != m_cache.end() && it->second.expires_ms > now) {
+            owner = it->second.owner;
+            cached = true;
+        }
+    }
+    if (!cached) {
+        owner = find_socket_owner_path(proto, src, dst).value_or("");
+        constexpr int64_t TTL_MS = 2000;
+        std::scoped_lock l(m_mutex);
+        if (m_cache.size() > 4096) {
+            std::erase_if(m_cache, [now](const auto &kv) {
+                return kv.second.expires_ms <= now;
+            });
+        }
+        m_cache[key] = CacheEntry{owner, now + TTL_MS};
+    }
+    if (owner_out != nullptr) {
+        *owner_out = owner;
+    }
+    return bypass(owner);
+}
