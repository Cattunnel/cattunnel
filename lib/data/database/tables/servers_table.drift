import 'protocols_table.drift';
import 'routing_profiles_table.drift';
import 'subscriptions_table.drift';

CREATE TABLE IF NOT EXISTS servers(
  id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
  ip_address TEXT NOT NULL,
  name TEXT NOT NULL,
  domain TEXT NOT NULL,
  login TEXT NOT NULL,
  password TEXT NOT NULL,
  vpn_protocol_id INTEGER NOT NULL,
  routing_profile_id INTEGER NOT NULL,
  selected BOOLEAN NOT NULL DEFAULT false,
  ipv6_enabled BOOLEAN NOT NULL DEFAULT true,
  anti_dpi BOOLEAN NOT NULL DEFAULT false,
  anti_dpi_mode INTEGER NOT NULL DEFAULT 0,
  tls_profile TEXT NOT NULL DEFAULT '',
  anti_dpi_desync TEXT NOT NULL DEFAULT '',
  h2_padding_frames INTEGER NOT NULL DEFAULT 0,
  block_quic BOOLEAN NOT NULL DEFAULT false,
  ru_exit BOOLEAN NOT NULL DEFAULT false,
  tls_prefix TEXT,
  custom_sni TEXT,
  subscription_id INTEGER NULL,
  FOREIGN KEY (vpn_protocol_id) REFERENCES protocols(id),
  FOREIGN KEY (routing_profile_id) REFERENCES routing_profiles(id),
  FOREIGN KEY (subscription_id) REFERENCES subscriptions(id)
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_one_selected_server
  ON servers(selected)
  WHERE selected = 1;