<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep everything out of cloud backups AND device-to-device
     transfers (allowBackup="false" alone no longer stops the latter). The app
     holds VPN credentials, the subscription token + age key, and - while
     connected - the vendor service's full config; a new phone re-imports all
     of it from the bot in a minute. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
